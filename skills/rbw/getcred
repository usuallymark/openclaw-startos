#!/bin/sh
# getcred VAR — print a credential configured in Configure External Services.
#
# If VAR is set in the environment ("Enter manually"), print it.
# Otherwise, if VAR_FROM_VAULT is set ("Fetch from Vaultwarden", value
# "<entry>:<field>"), fetch that field from Vaultwarden with rbw and print it.
# The value is printed without a trailing newline. Exits non-zero, with a
# message on stderr only, if the credential is not configured or the lookup
# fails. A failed or empty lookup is retried once after `rbw sync`, so vault
# edits are picked up without a manual sync. Secrets never appear in error
# messages.
set -u

usage() {
  echo "usage: getcred VAR   (e.g. getcred NAS_PASS)" >&2
  exit 2
}

[ $# -eq 1 ] || usage
var=$1
case $var in
  '' | *[!A-Za-z0-9_]* | [0-9]*) usage ;;
esac

eval "plain=\${$var-}"
if [ -n "$plain" ]; then
  printf '%s' "$plain"
  exit 0
fi

eval "pointer=\${${var}_FROM_VAULT-}"
if [ -z "$pointer" ]; then
  echo "getcred: $var is not configured (enable the service in Configure External Services)" >&2
  exit 1
fi

entry=${pointer%%:*}
field=${pointer#*:}
if [ -z "$entry" ] || [ "$field" = "$pointer" ] || [ -z "$field" ]; then
  echo "getcred: ${var}_FROM_VAULT must look like <entry>:<field>" >&2
  exit 1
fi

# rbw locations used by the package (also set in the gateway environment).
: "${XDG_CONFIG_HOME:=/data/.openclaw/rbw/config}"
: "${XDG_CACHE_HOME:=/data/.openclaw/rbw/cache}"
: "${XDG_RUNTIME_DIR:=/data/.openclaw/rbw/runtime}"
export XDG_CONFIG_HOME XDG_CACHE_HOME XDG_RUNTIME_DIR

lookup() {
  value=$(rbw get --field "$field" "$entry" 2>/dev/null) && [ -n "$value" ]
}

# rbw answers from its local copy of the vault, which it refreshes only
# now and then, so an entry added or fixed in Vaultwarden may not be seen
# yet. On a miss, sync once (quietly, with a time limit) and look again.
if ! lookup; then
  if command -v timeout >/dev/null 2>&1; then
    timeout 30 rbw sync >/dev/null 2>&1
  else
    rbw sync >/dev/null 2>&1
  fi
  if ! value=$(rbw get --field "$field" "$entry" 2>/dev/null); then
    echo "getcred: Vaultwarden lookup failed for entry \"$entry\", field \"$field\" ($var), also after rbw sync. Check that Vaultwarden is enabled and the entry and field exist." >&2
    exit 1
  fi
  if [ -z "$value" ]; then
    echo "getcred: Vaultwarden entry \"$entry\", field \"$field\" is empty ($var), also after rbw sync" >&2
    exit 1
  fi
fi
printf '%s' "$value"
